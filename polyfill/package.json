{
  "private": true,
  "name": "temporal-polyfill",
  "version": "1.0.1",
  "title": "Temporal Polyfill",
  "description": "A lightweight polyfill for Temporal, successor to the JavaScript Date object",
  "author": {
    "name": "Adam Shaw",
    "email": "arshaw@users.noreply.github.com",
    "url": "http://arshaw.com/"
  },
  "license": "MIT",
  "copyright": "2026 Adam Shaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/fullcalendar/temporal-polyfill.git",
    "directory": "polyfill"
  },
  "scripts": {
    "lint": "pnpm run lint:readme && biome check . --max-diagnostics=1000",
    "lint:fix": "pnpm run lint:readme:fix && biome check --apply .",
    "lint:readme": "node ./scripts/lint-readme-cdn-version.js",
    "lint:readme:fix": "node ./scripts/lint-readme-cdn-version.js fix",
    "build": "./scripts/clean.js && pnpm run tsc && concurrently -c auto npm:manifest npm:readme npm:changelog npm:license npm:bundle",
    "dev": "./scripts/clean.js && pnpm run tsc && concurrently -c auto npm:manifest:dev npm:tsc:dev npm:readme npm:changelog npm:license npm:bundle:dev",
    "tsc": "tsc --build tsconfig.build.json",
    "tsc:all": "tsc -p tsconfig.json --noEmit --tsBuildInfoFile dist/.tsbuildinfo.all",
    "tsc:dev": "tsc --build tsconfig.build.json --watch --preserveWatchOutput --pretty",
    "bundle": "pnpm --dir ../utils run build && ./scripts/bundle.js",
    "bundle:dev": "pnpm --dir ../utils run build && ./scripts/bundle.js --dev",
    "gzip-reuse": "./scripts/gzip-reuse.js",
    "minify": "./scripts/minify.js",
    "manifest": "./scripts/manifest.js",
    "manifest:dev": "./scripts/manifest.js --dev",
    "readme": "./scripts/readme.js",
    "changelog": "cp CHANGELOG.md dist",
    "license": "cp LICENSE dist",
    "test": "pnpm run vitest && pnpm run test262",
    "vitest": "./scripts/vitest.js",
    "vitest:dev": "vitest dev",
    "vitest:debug": "vitest run --no-isolate --no-file-parallelism --test-timeout 3600000",
    "test262": "./scripts/test262.js",
    "clean": "./scripts/clean.js --tsc",
    "size": "pnpm run minify && ./scripts/size.js"
  },
  "type": "module",
  "buildConfig": {
    "exports": {
      ".": {
        "src": "classApi/basic/index",
        "types": "typeOverrides/index"
      },
      "./global": {
        "src": "classApi/basic/global",
        "types": "typeOverrides/global",
        "iife": true
      },
      "./shim": {
        "src": "classApi/basic/shim"
      },
      "./implementation": {
        "src": "classApi/basic/implementation",
        "types": "typeOverrides/implementation"
      },
      "./full": {
        "src": "classApi/full/index",
        "types": "typeOverrides/index",
        "dist": "full/index"
      },
      "./full/global": {
        "src": "classApi/full/global",
        "types": "typeOverrides/global",
        "iife": true
      },
      "./full/shim": {
        "src": "classApi/full/shim"
      },
      "./full/implementation": {
        "src": "classApi/full/implementation",
        "types": "typeOverrides/implementation"
      },
      "./types/global": {
        "src": "classApi/globalTypes"
      },
      "./fns": {
        "src": "funcApi/index",
        "dist": "fns/index"
      },
      "./fns/Calendar": {
        "src": "funcApi/calendar"
      },
      "./fns/Instant": {
        "src": "funcApi/instant"
      },
      "./fns/ZonedDateTime": {
        "src": "funcApi/zonedDateTime"
      },
      "./fns/PlainDateTime": {
        "src": "funcApi/plainDateTime"
      },
      "./fns/PlainDate": {
        "src": "funcApi/plainDate"
      },
      "./fns/PlainTime": {
        "src": "funcApi/plainTime"
      },
      "./fns/PlainYearMonth": {
        "src": "funcApi/plainYearMonth"
      },
      "./fns/PlainMonthDay": {
        "src": "funcApi/plainMonthDay"
      },
      "./fns/Duration": {
        "src": "funcApi/duration"
      },
      "./fns/Now": {
        "src": "funcApi/now"
      }
    }
  },
  "publishConfig": {
    "directory": "./dist",
    "linkDirectory": true
  },
  "dependencies": {
    "temporal-spec": "workspace:1.0.0",
    "temporal-utils": "workspace:1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.5.1",
    "@js-temporal/temporal-test262-runner": "github:fullcalendar/temporal-test262-runner#main",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@swc/core": "^1.15.40",
    "@types/node": "^18.11.9",
    "concurrently": "^8.2.0",
    "export-size": "workspace:*",
    "gzip-size": "^7.0.0",
    "gzip-size-cli": "^5.1.0",
    "rollup": "^4.9.6",
    "rollup-plugin-dts": "^6.1.0",
    "terser": "workspace:*",
    "typescript": "~5.3.3",
    "vitest": "^1.2.2",
    "yargs": "^17.7.2"
  },
  "devDependenciesNotes": {
    "@biomejs/biome": [
      "BUG: Pinned to 1.5.1 due to this regression in 1.5.3:",
      "https://github.com/biomejs/biome/issues/1654"
    ]
  }
}
