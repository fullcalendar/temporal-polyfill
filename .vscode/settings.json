{
  "editor.rulers": [80],
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "quickfix.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/*.code-search": true,
    "misc/locale-data/data/**": true
  },
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsdk.path": "polyfill/node_modules/typescript/lib",
  "biome.lspBin": "polyfill/node_modules/@biomejs/biome/bin/biome"
}
